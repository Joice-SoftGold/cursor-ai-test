# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values

resource_group_name = "rg-gitops-webapp"
location            = "eastus"
acr_name            = "youruniqueacrname"  # Must be globally unique, alphanumeric only
aks_cluster_name    = "aks-gitops-webapp"
kubernetes_version  = "1.28"
node_count          = 2
vm_size             = "Standard_B2s"
